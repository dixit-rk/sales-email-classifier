# ChemQuote AI backend configuration.
# Copy this file to backend/.env and fill in your own values. Never commit backend/.env.

# --- Server -------------------------------------------------------------------
PORT=5000
# Where the React app runs. Used for CORS, the Socket.IO origin and the post-login redirect.
FRONTEND_URL=http://localhost:5173
# Number of proxies in front of this API (0 when none, usually 1 behind a host or load balancer).
# Needed so each visitor's real network address is read correctly (playground limits). See README.
TRUST_PROXY_HOPS=0

# --- Database -----------------------------------------------------------------
# MongoDB connection string (for example a MongoDB Atlas "mongodb+srv://..." URI).
MONGODB_URI=<your MongoDB connection string>

# --- Sessions and token encryption ---------------------------------------------
# Long random string that signs the session cookie.
SESSION_SECRET=<long random string>
# 32 random bytes as 64 hex characters; encrypts each user's Google refresh token (AES-256-GCM).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=<64 hex characters>

# --- Google sign-in and Gmail --------------------------------------------------
# OAuth client from Google Cloud Console (type: Web application).
GOOGLE_CLIENT_ID=<your OAuth client id>
GOOGLE_CLIENT_SECRET=<your OAuth client secret>
# Must exactly match an "Authorized redirect URI" of that OAuth client.
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# --- Gmail push notifications (Google Cloud Pub/Sub) ----------------------------
GOOGLE_CLOUD_PROJECT_ID=<your Google Cloud project id>
# Full topic name that Gmail publishes to, for example projects/<project-id>/topics/<topic>.
GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/<topic-name>
# The push subscription's OIDC settings; the webhook rejects calls that do not match them.
PUBSUB_AUDIENCE=<audience set on the push subscription, usually the webhook URL>
PUBSUB_SERVICE_ACCOUNT_EMAIL=<service account email set on the push subscription>

# --- AI ------------------------------------------------------------------------
# Google AI Studio / Gemini API key and the model to use.
GEMINI_API_KEY=<your Gemini API key>
GEMINI_MODEL=<a Gemini model id, for example a Flash-Lite model>

# --- Public playground (optional; the values shown are the defaults) ---------------
# Free requests per device and per network address, and a global cap per day.
PLAYGROUND_LIMIT_PER_DEVICE=15
PLAYGROUND_LIMIT_PER_IP=15
PLAYGROUND_DAILY_CAP=300
# Secret used to hash device and network identifiers before they are stored.
# Falls back to SESSION_SECRET when empty.
PLAYGROUND_HASH_SECRET=

# --- Frontend (this belongs in frontend/.env, not here) ----------------------------
# VITE_API_URL=http://localhost:5000
