# ChemQuote AI frontend configuration.
# For local work, copy this file to frontend/.env (optional: the default is http://localhost:5000).
# On Vercel, add the same name under Project Settings > Environment Variables.
# It is read at BUILD time, so redeploy after changing it. Never put secrets here: everything in a VITE_ variable is public.

# Address of the API, with https and no trailing slash.
VITE_API_URL=http://localhost:5000
